{% load static %}{
  "name": "PackMate",
  "short_name": "PackMate",
  "description": "Cub Scout Pack directory: dens, cubs, and families at a glance.",
  "start_url": "{% url 'mobile:index' %}",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#c8202f",
  "icons": [
    {
      "src": "{% static 'mobile/icons/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'mobile/icons/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'mobile/icons/icon-maskable-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{% static 'mobile/icons/icon-maskable-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
