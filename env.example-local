# .env for local development with Pack 144 defaults.
# Copy to .env and adjust as needed.
# For production settings see env.example and packman/settings/production.py.
#
# DJANGO_SETTINGS_MODULE is set by util/start_local.sh — no need to set it here.


# PACK SPECIFIC
# -------------------------------------------------------------------
PACK_NAME="Cub Scouts Pack 144"
PACK_SHORTNAME="Pack 144"
PACK_DOMAIN_NAME="pack144.org"
PACK_LOCATION="Seattle, Washington"
PACK_TAGLINE="Since 1929"
PACK_YEAR_BEGIN_MONTH=7
PACK_YEAR_BEGINS_DAY=1


# SECURITY
# A placeholder key is fine for local dev — never use this in production.
# Generate a key for local dev with the command:
# uv run python manage.py shell -c \
#   "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# -------------------------------------------------------------------
DJANGO_SECRET_KEY="django-insecure-replace-me-for-local-dev-only"
# DEBUG defaults to True in local settings; uncomment to override
# DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"


# DATABASE
# Leave commented to use the default db.sqlite3 in the project root.
# To run against a production backup converted with util/pg_to_sqlite.py, or
# if using worktrees (see util/start_local.sh) so all worktrees share the
# same database, set an absolute path here.
# -------------------------------------------------------------------
# DATABASE_URL="sqlite:////path/to/backup.sqlite3"


# MEDIA
# Leave commented to use the default media/ directory in the project root.
# If using worktrees (see util/start_local.sh), update this to an absolute
# path so all worktrees share the same media files instead of duplicating them.
# -------------------------------------------------------------------
# DJANGO_MEDIA_ROOT="/path/to/shared/media"


# LOCAL DATA SYNC (util/sync_local_data.sh)
# Used to pull a fresh copy of the beta/production database and media files.
# -------------------------------------------------------------------
## SSH destination for the beta/production server (used to run pg_dump).
# SYNC_SSH_HOST=deploy@example.com
## Remote media directory to rsync from, on that same server.
# SYNC_REMOTE_MEDIA_DIR="~/apps/media/"
## Email of an existing user whose password should be reset after syncing,
## so you have a known login for local dev (e.g. for Copilot to use).
# SYNC_RESET_PASSWORD_EMAIL="you@example.com"
## The password to set for SYNC_RESET_PASSWORD_EMAIL above.
# SYNC_RESET_PASSWORD="a-known-local-password"


# EMAIL
# consolemail:// prints emails to the terminal instead of sending them.
# -------------------------------------------------------------------
DJANGO_EMAIL_URL="consolemail://"
DJANGO_ADMINS="Pack Admin:admin@pack144.org"
DJANGO_DEFAULT_FROM_EMAIL="no-reply@pack144.org"


# LOCALIZATION
# -------------------------------------------------------------------
TIME_ZONE="America/Los_Angeles"
